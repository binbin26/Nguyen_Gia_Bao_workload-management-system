# MongoDB — MUST run as replica set for ACID transactions (rs.initiate() on single-node)
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB_NAME=vnpt_ai_performance
MONGO_REPLICA_SET=rs0

# Application
APP_NAME=AI Workforce Management
DEBUG=false

# JWT (Phase 1+ auth)
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Internal cron job auth (daily-reset endpoint / manual trigger)
INTERNAL_CRON_SECRET=change-me-internal-cron-secret
