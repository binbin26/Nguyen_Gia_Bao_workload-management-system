# MongoDB — MUST run as replica set for ACID transactions (rs.initiate() on single-node)
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB_NAME=vnpt_ai_performance
MONGO_REPLICA_SET=rs0

# Application
APP_NAME=AI Workforce Management
DEBUG=false
CORS_ALLOWED_ORIGINS=["https://workforce.example.com"]

# Generate three independent random values of at least 32 bytes. Never commit
# production secrets and never reuse the access secret for refresh or CSRF.
JWT_SECRET_KEY=replace-with-random-access-secret
JWT_REFRESH_SECRET_KEY=replace-with-different-random-refresh-secret
CSRF_SECRET_KEY=replace-with-different-random-csrf-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
JWT_ISSUER=vnpt-workforce-api
JWT_AUDIENCE=vnpt-workforce-web

# Must be true in production. False is allowed only for isolated HTTP local dev.
COOKIE_SECURE=true

# Internal cron job auth (daily-reset endpoint / manual trigger)
INTERNAL_CRON_SECRET=change-me-internal-cron-secret
